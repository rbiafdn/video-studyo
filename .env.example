# Video Stüdyo – ortam değişkenleri. Bu dosyayı .env olarak kopyalayıp doldurun.
# Anahtarlar yalnızca sunucuda kalır; tarayıcıya gönderilmez.

PORT=3000

# --- Anthropic Claude (senaryo planlama) ---
# https://platform.claude.com -> API Keys
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# "Zor planlama" işaretlenince kullanılan daha güçlü (ve pahalı) model
CLAUDE_MODEL_HARD=claude-opus-5-5

# --- Google Gemini (sahne görselleri + otomatik hareketli sahne videosu) ---
# https://aistudio.google.com -> Get API key (görsel/video için faturalandırma açık olmalı)
GEMINI_API_KEY=
# Görsel modeli (Nano Banana 2.1). Alternatifler: gemini-3.1-flash-lite-image, gemini-3-pro-image
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
# Görsel boyutu: 1K | 2K | 4K
GEMINI_IMAGE_SIZE=1K
# Video modeli. Veo modelleri 22 Ekim 2026'da Gemini API'den kaldırıldı;
# Google'ın önerdiği yedek gemini-omni-1.2-flash (görsel + prompt -> sesli video).
VEO_MODEL=gemini-omni-1.2-flash
# Video çözünürlüğü: 360p | 720p | 1080p | 4k   ve süre: 3s..15s
GEMINI_VIDEO_RESOLUTION=720p
GEMINI_VIDEO_DURATION=8s

# --- ElevenLabs (karakter sesleri + ses değiştirme) ---
# https://elevenlabs.io -> Profile -> API Keys
ELEVENLABS_API_KEY=
# TTS modeli (Türkçe destekler): eleven_multilingual_v2 | eleven_v3 | eleven_flash_v2_5
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
# Speech-to-Speech (Voice Changer) modeli: eleven_multilingual_sts_v2
ELEVENLABS_STS_MODEL=eleven_multilingual_sts_v2
# Diyaloglar (duygu etiketli, [shouting] [crying] [whispers]): eleven_v4 | eleven_v3
ELEVENLABS_DIALOGUE_MODEL=eleven_v4
# Müzik ve ses efekti üretimi
ELEVENLABS_MUSIC_MODEL=music_v2_5
ELEVENLABS_SFX_MODEL=eleven_text_to_sound_v3
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

# --- fal.ai (sabit kamerada konuşan karakter, dudak uyumu) ---
# https://fal.ai/dashboard/keys
FAL_KEY=
# Birincil avatar modeli (Kling AI Avatar v2). Pro için: fal-ai/kling-video/ai-avatar/v2/pro
FAL_AVATAR_MODEL=fal-ai/kling-video/ai-avatar/v2/standard
# Yedek model (InfiniteTalk fal.ai'de artık desteklenmiyor; OmniHuman kullanılıyor)
FAL_AVATAR_FALLBACK_MODEL=fal-ai/bytedance/omnihuman


# --- Seedance (fal.ai) hareketli sahne ---
# En güncel Seedance image-to-video modeli (fal.ai). Çözünürlük: 480p | 720p | 1080p. Süre üst sınırı 4-30 sn.
SEEDANCE_MODEL=bytedance/seedance-2.5/us/image-to-video
SEEDANCE_RESOLUTION=720p
SEEDANCE_MAX_DURATION=8
